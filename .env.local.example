# Local dev settings — copy to `.env.local` and fill in.
#
#   cp .env.local.example .env.local
#
# `.env.local` is gitignored. The hosted app reads these same four names from
# Vercel's environment variables instead (DEPLOY.md §5).
#
# Without a .env.local, `python3 server.py` runs exactly as it did before the
# app went hosted: no login, no saved gallery, proxy open. That is intentional —
# the local tool should keep working with zero setup.

# Project settings -> Data API -> Project URL
SUPABASE_URL=https://awfqeamcxseqrkwvbzip.supabase.co

# Project settings -> API keys -> anon / public.
# Public by design: it identifies the project and authorizes nothing. Row-level
# security is what protects a gallery. Never put the service_role key here.
SUPABASE_ANON_KEY=

# Who may sign in. Comma-separated, no '@' on domains.
# Keep in step with the `allowlist` table in supabase/schema.sql — see DEPLOY.md §6.
ALLOWED_EMAIL_DOMAINS=yotpo.com
ALLOWED_EMAILS=lvacavliev@gmail.com

# Set to 0 to let /proxy serve without a session locally, even with the above
# configured. Useful when testing page detection without signing in.
# REQUIRE_AUTH=0
